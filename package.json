{
  "name": "pi-project-exploration-memory",
  "version": "0.1.0",
  "description": "Project-local exploration memory extension for Pi",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "pi": {
    "extensions": [
      "extensions/project-exploration-memory/index.ts"
    ],
    "skills": [
      "skills"
    ]
  },
  "files": [
    "extensions",
    "skills",
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "tsx --test",
    "typecheck": "tsc --noEmit",
    "coverage": "c8 --all --include='src/**/*.ts' --include='extensions/**/*.ts' --check-coverage --statements=100 --branches=100 --functions=100 --lines=100 --reporter=text-summary --reporter=text npm test",
    "mutation": "stryker run",
    "check": "npm run typecheck && npm test && npm run coverage && npm run mutation",
    "smoke": "npm pack --dry-run --json"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@stryker-mutator/core": "^10.1.1",
    "@types/node": "^22.0.0",
    "c8": "^12.0.0",
    "tsx": "^4.19.0",
    "typebox": "1.3.27",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
